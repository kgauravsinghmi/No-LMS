# ==============================================================================
# Luminary LMS - Environment Configuration Example
# ==============================================================================
# Copy this file to .env or .env.local to configure custom environment settings.
# All client-accessible variables must be prefixed with VITE_.

# Application Metadata
VITE_APP_NAME="Luminary LMS"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Next-Generation Self-Contained Learning Management Platform"

# Environment Mode (development | test | production)
VITE_APP_ENV="development"

# Local Storage Configuration
VITE_STORAGE_PREFIX="luminary_lms_"

# Default UI Settings (light | dark | system)
VITE_DEFAULT_THEME="system"

# Optional Feature Flags
VITE_ENABLE_EXPERIMENTAL_DIAGRAMS=true
VITE_ENABLE_CERTIFICATE_EXPORT=true
VITE_ENABLE_GAMIFICATION=true

# Development Server Configuration (optional)
VITE_DEV_PORT=5173
